# ==========================================
# SmartPark AI Configuration
# ==========================================

APP_NAME=SmartPark AI
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True

# ==========================================
# API
# ==========================================

API_V1_STR=/api/v1

# ==========================================
# Security Settings
# ==========================================

SECRET_KEY=xxxxxxxxxxxxx7fffb7ba70b54645aec7090fxxxxxxxxxxxxxxxxxxxxxxxx
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==========================================
# Development Database
# ==========================================

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=smartpark_ai
DATABASE_USER=postgres
DATABASE_PASSWORD=xxxxxxxxxxxxxx

# ==========================================
# Test Database
# ==========================================

TEST_DATABASE_HOST=localhost
TEST_DATABASE_PORT=5432
TEST_DATABASE_NAME=smartpark_ai_test
TEST_DATABASE_USER=postgres
TEST_DATABASE_PASSWORD=postgres

# ==========================================
# CORS
# ==========================================

BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ==========================================================
# M-Pesa (Daraja API)
# ==========================================================

MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=dummy
MPESA_CONSUMER_SECRET=dummy
MPESA_SHORTCODE=174379
MPESA_PASSKEY=dummy
MPESA_CALLBACK_URL=https://your-domain/api/payments/mpesa/callback
MPESA_TIMEOUT_SECONDS=30

# ==========================================
# MACHINE LEARNING MODEL
# ==========================================

MODEL_PATH=models/model.pkl