# ==========================================
# SmartPark AI Configuration
# ==========================================

APP_NAME=SmartPark AI
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True

# ==========================================
# API
# ==========================================

API_V1_STR=/api/v1

# ==========================================
# Security Settings
# ==========================================

SECRET_KEY=xxxxxxxxxxxxx7fffb7ba70b54645aec7090fxxxxxxxxxxxxxxxxxxxxxxxx
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==========================================
# Development Database
# ==========================================

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=smartpark_ai
